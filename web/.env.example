# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Every variable here is PUBLIC: Vite ships VITE_* values to the browser.
# Never put a secret key (Supabase service role key, Groq, Gemini) in here.

# "true"  = use the fake in-browser API (src/api/mock.ts). Works with no backend.
# "false" = call the real FastAPI backend (src/api/http.ts).
VITE_USE_MOCK=true

# Base URL of the FastAPI backend, no trailing slash.
# Local:  http://127.0.0.1:8000
# Render: https://your-service.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Supabase project URL and PUBLIC anon key (Project Settings -> API).
# The anon key is safe to ship to browsers; the service role key is NOT.
# Only needed when VITE_USE_MOCK=false.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
